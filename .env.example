# LiveKit Cloud project credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# The agent name must match the explicit dispatch name used by the API.
LIVEKIT_AGENT_NAME=plecoach-tutor

# LiveKit Inference model configuration
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=e90c6678-f0d3-4767-9883-5d0ecf5894a8
LIVEKIT_STT_LANGUAGE=zh-CN
LIVEKIT_TTS_LANGUAGE=zh

# Docker Compose overrides this hostname for the API and agent containers.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=604800

# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Embedded into the browser build by Docker Compose.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional host port for the web container.
WEB_PORT=3000
